# =============================================================================
# Intelligent RBAC Policy Auditor — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Variables marked [required] must be set for the service to start.
# Variables marked [optional] fall back to the listed default if unset.
#
#   cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# [required] PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# When using docker-compose, the default below matches the compose db service.
DATABASE_URL=postgresql://rbac_user:rbac_password@localhost:5432/rbac_auditor


# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------

# [optional] LLM backend to use for audit analysis and query answering.
# Accepted values: openai | azure_openai
# Default: openai
LLM_PROVIDER=openai

# [required when LLM_PROVIDER=openai]
# API key issued by OpenAI (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-your-openai-api-key-here

# [required when LLM_PROVIDER=azure_openai]
# API key for your Azure OpenAI resource.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# [required when LLM_PROVIDER=azure_openai]
# Full endpoint URL for your Azure OpenAI resource.
# Format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# [required when LLM_PROVIDER=azure_openai]
# Name of the model deployment inside your Azure OpenAI resource.
# Example: gpt-4o, gpt-35-turbo
AZURE_OPENAI_DEPLOYMENT=your-deployment-name


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# [optional] Enable API key authentication on all endpoints except /health.
# When true, every request must include: Authorization: Bearer <API_KEY>
# Accepted values: true | false
# Default: false
AUTH_ENABLED=false

# [required when AUTH_ENABLED=true]
# The API key the service will accept. Choose a long, random string.
# Example: openssl rand -hex 32
API_KEY=your-secret-api-key-here


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# [optional] Maximum number of requests per minute allowed per client IP.
# Requests exceeding this limit receive HTTP 429 with a Retry-After header.
# Default: 60
RATE_LIMIT_PER_MINUTE=60


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# [optional] Minimum log level for structured JSON output.
# Accepted values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Audit Pipeline
# -----------------------------------------------------------------------------

# [optional] Number of days of inactivity after which a privileged role
# assignment is considered dormant and flagged as a finding.
# Default: 30
DORMANT_THRESHOLD_DAYS=30
