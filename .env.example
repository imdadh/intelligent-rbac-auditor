# ---------------------------------------------------------------------------
# Intelligent RBAC Policy Auditor — Environment Variable Template
#
# Copy this file to .env and fill in the values appropriate for your
# environment.  The .env file is never committed to version control.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (overridden by docker-compose.yml when running via Compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://rbac_user:rbac_password@localhost:5432/rbac_auditor

# PostgreSQL credentials used by docker-compose.yml to configure the db
# service.  These must match the credentials embedded in DATABASE_URL above.
POSTGRES_USER=rbac_user
POSTGRES_PASSWORD=rbac_password
POSTGRES_DB=rbac_auditor

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Accepted values: openai | azure_openai
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI (required only when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Set to true to require an API key on all endpoints except /health.
AUTH_ENABLED=false
API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Accepted values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Audit pipeline
# ---------------------------------------------------------------------------
# Number of days of inactivity that triggers a dormant-privileged finding.
DORMANT_THRESHOLD_DAYS=30
